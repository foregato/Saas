# =====================================================================
# Copie este arquivo para backend/.env e preencha com os valores reais.
# NUNCA versione o arquivo .env (adicione ao .gitignore).
# =====================================================================

# Banco de dados MySQL (Hostinger fornece host/usuário/senha no hPanel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mei_saas
DB_USERNAME=root
DB_PASSWORD=

# URL do frontend (para CORS). Em produção, o domínio publicado no Vercel/Hostinger.
FRONTEND_URL=http://localhost:5173

# Ambiente
APP_ENV=local
APP_DEBUG=true

# Upload de documentos
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# Gateways de pagamento (fase de assinaturas — preencher quando integrar)
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
